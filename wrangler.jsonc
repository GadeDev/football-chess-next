{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "universofutbol-football-chess",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "ENVIRONMENT": "production",
    "CONTENT_SLUG": "universofutbol-football-chess",
    "PUBLIC_BASE_PATH": "/universofutbol/football-chess",
    "UNIVERSO_FUTBOL_URL": "https://universofutbol.com",
    "PLATFORM_API_ORIGIN": "https://fc-platform-api.yanagiho.workers.dev"
  },
  // 同一アカウントの workers.dev 同士は素の fetch() では相手のWorkerに到達しないため、
  // Universo Platform API (fc-platform-api) はサービスバインディング経由で呼ぶ
  "services": [
    {
      "binding": "PLATFORM_API",
      "service": "fc-platform-api"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "MATCH_ROOM",
        "class_name": "MatchRoom"
      },
      {
        "name": "ACCOUNTS",
        "class_name": "AccountStore"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["MatchRoom"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["AccountStore"]
    }
  ]
}
